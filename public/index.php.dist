<?php

// Load Composer's autoloader
require __DIR__ . '/../vendor/autoload.php';

// Load environment variables
if (file_exists(__DIR__ . '/../.env')) {
    $dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
    $dotenv->load();
}

// Start the session
session_start();

// Load routes
require __DIR__ . '/../config/routes.php';

// Run the application
$router->dispatch();
