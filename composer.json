{
    "name": "pocketphp/pocketphp",
    "description": "A lightweight and powerful PHP boilerplate for building web applications for small scale projects on shared hosting",
    "type": "project",
    "keywords": ["php", "boilerplate", "mvc", "pocketphp", "php-boilerplate", "web-development"],
    "version": "1.0.0-dev",
    "authors": [{
        "name": "Himanshu Nishad",
        "homepage": "https://github.com/madfortech",
        "role": "Lead Developer"
    }],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^6.8",
        "pocketphp/pocket-error-log": "1.0.0-dev",
        "pocketphp/pocketcookies": "1.0.0-dev",
        "pocketphp/pockethashing": "1.0.0-dev",
        "pocketphp/pocketsecurity": "1.0.0-dev",
        "pocketphp/post-owner": "1.0.0-dev",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "PocketPHP\\Controller\\Core\\": "src/Controller/Core/",
            "PocketPHP\\Controller\\": "src/Controller/",
            "PocketPHP\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('public/index.php') || copy('public/index.php.dist', 'public/index.php');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
         
        { "type": "path", "url": "C:\\xampp\\htdocs\\PocketErrorLog" },
        { "type": "path", "url": "C:\\xampp\\htdocs\\PocketCookies" },
        { "type": "path", "url": "C:\\xampp\\htdocs\\PocketSecurity" },
        { "type": "path", "url": "C:\\xampp\\htdocs\\PocketHashing" },
        { "type": "path", "url": "C:\\xampp\\htdocs\\PostOwner"},
        { "type": "path", "url": "C:\\xampp\\htdocs\\PocketTesting"}
    ]
}
